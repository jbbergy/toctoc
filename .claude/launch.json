{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "server",
        "run",
        "dev"
      ],
      "env": {
        "DATABASE_URL": "postgres://postgres@127.0.0.1:55499/postgres",
        "PG_POOL_MAX": "1"
      },
      "port": 3000
    },
    {
      "name": "web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--port",
        "5173",
        "--strictPort"
      ],
      "env": {
        "VITE_SYNC_URL": "/api"
      },
      "port": 5173
    }
  ]
}